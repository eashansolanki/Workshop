{
  "mcpServers": {
    "workshop-advanced-web-browsing": {
      "command": "${PLUGIN_ROOT}/.venv/bin/python",
      "args": [
        "-m",
        "workshop.server",
        "--integration",
        "advanced-web-browsing"
      ],
      "env": {
        "PYTHONPATH": "${PLUGIN_ROOT}",
        "WORKSHOP_WORKSPACE": "${PLUGIN_ROOT}/workspace",
        "WORKSHOP_ALLOW_CODE": "0"
      },
      "type": "stdio",
      "cwd": "${PLUGIN_ROOT}"
    },
